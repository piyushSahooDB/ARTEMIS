# ARTEMIS Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Database
ARTEMIS_DB_PATH=artemis.db
ARTEMIS_LOG_LEVEL=INFO

# Crawler Identification (Optional - Leave blank to use standard polite defaults)
# ARTEMIS_CONTACT_EMAIL=student@university.edu
# ARTEMIS_USER_AGENT=ARTEMIS-AcademicScout/0.2.0 (+https://github.com/piyushSahooDB/ARTEMIS; mailto:student@university.edu)

# LLM Configuration (Replaceable interface: mock [default, offline] or gemini)
ARTEMIS_LLM_PROVIDER=mock
# GEMINI_API_KEY=your_gemini_api_key_here

# Streamlit Web App Configuration
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost

# Gmail OAuth 2.0 Credentials (For drafting only)
# GMAIL_CLIENT_SECRETS_FILE=credentials.json
# GMAIL_TOKEN_FILE=token.json
